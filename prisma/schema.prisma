// Lukreative Solutions — agency task tracker.
//
// Postgres in every environment. DATABASE_URL must be a direct connection
// string (postgres://…). Vercel's database integration may expose it under a
// prefixed name such as DATABASE1_DATABASE_URL — add a plain DATABASE_URL
// alongside it rather than renaming this, so the Prisma CLI works too.
//
// Not the prisma+postgres:// Accelerate URL: that speaks HTTP and needs
// @prisma/extension-accelerate, which this app does not use.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  slug         String   @unique
  shareToken   String   @unique // secret in the client's share link
  contactName  String   @default("")
  contactEmail String   @default("")
  color        String   @default("#6366f1")
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())

  tasks       Task[]
  requests    TaskRequest[]
  recurrences Recurrence[]
}

model Member {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  role   String  @default("") // job title, e.g. "Performance marketing"
  active Boolean @default(true)

  // Sign-in. The admin sets passwords directly; with a team this size an
  // email-based reset flow would be more moving parts than it is worth.
  // `role` above stays the job title — this is the permission flag.
  email        String  @default("")
  passwordHash String  @default("") // "salt:hash", empty until a password is set
  isAdmin      Boolean @default(false)

  tasks       Task[]
  recurrences Recurrence[]
}

model Task {
  id       Int    @id @default(autoincrement())
  title    String
  channel  String @default("") // Campaign / channel
  priority String @default("Medium") // High | Medium | Low
  status   String @default("Not Started") // Not Started | In Progress | Hold | Completed

  clientId   Int?
  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assigneeId Int?
  assignee   Member? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  startDate     String @default("") // YYYY-MM-DD, "" when unset
  dueDate       String @default("")
  completedDate String @default("")
  notes         String @default("")

  // Client-portal visibility. Internal work stays hidden by default.
  visibleToClient Boolean @default(true)

  // Set when the task was created by approving a client request.
  request TaskRequest?

  // Work that must finish before this task can start, and the mirror side:
  // tasks waiting on this one. Self-referencing many-to-many, because a task
  // can need several things and can hold up several others.
  prerequisites Task[] @relation("TaskDependency")
  blocks        Task[] @relation("TaskDependency")

  attachments Attachment[]

  // Set when this task was generated from a repeating series.
  recurrenceId   Int?
  recurrence     Recurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  occurrenceDate String      @default("") // the date in the series this one covers

  // Stops a second generation run creating the same occurrence twice.
  @@unique([recurrenceId, occurrenceDate])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([assigneeId])
  @@index([status])
}

model TaskRequest {
  id       Int    @id @default(autoincrement())
  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  title       String
  details     String @default("")
  requestedBy String @default("") // name the client typed
  priority    String @default("Medium")
  neededBy    String @default("")

  status       String    @default("pending") // pending | approved | declined
  decisionNote String    @default("")
  decidedAt    DateTime?

  // Populated when approved — links the request to the task it became.
  taskId Int?  @unique
  task   Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([status])
}

/// Reference images for a task. Bytes live in the database rather than object
/// storage so the app stays self-contained — the browser downscales each image
/// before upload, which keeps rows small enough for that to be reasonable.
///
/// Never select `data` when listing; it is only ever read by the route that
/// serves a single image.
model Attachment {
  id       Int    @id @default(autoincrement())
  taskId   Int
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  filename String
  mimeType String
  size     Int
  width    Int?
  height   Int?
  caption  String @default("")
  data     Bytes

  createdAt DateTime @default(now())

  @@index([taskId])
}

/// A repeating piece of work. The series is created once; each due date becomes
/// its own Task, so completion, notes and attachments stay per occurrence
/// instead of being overwritten every week.
model Recurrence {
  id     Int     @id @default(autoincrement())
  active Boolean @default(true)

  // What to create each time.
  title           String
  clientId        Int?
  client          Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assigneeId      Int?
  assignee        Member? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  channel         String  @default("")
  priority        String  @default("Medium")
  notes           String  @default("")
  visibleToClient Boolean @default(true)

  // When it falls due.
  frequency String @default("Weekly") // Daily | Weekly | Monthly
  weekdays  String @default("") // CSV, 0 = Sunday, for Weekly
  monthDay  Int? // day of month, for Monthly
  interval  Int    @default(1) // every N days/weeks/months

  // How far ahead to create the next one, so it shows up before it's due.
  leadDays Int @default(7)

  // Don't create the next one while the previous is still open, which would
  // otherwise pile up a month of identical unfinished tasks.
  skipIfOpen Boolean @default(true)

  startDate String @default("")
  endDate   String @default("")

  createdAt DateTime @default(now())

  tasks Task[]

  @@index([active])
}

/// Festivals, public holidays and any other date the team plans around.
///
/// `annual` means the same month and day every year — Independence Day is
/// stored once. Lunar and Islamic festivals move, so they are stored per year
/// and never repeated automatically, which would put them on the wrong date.
model ImportantDay {
  id     Int     @id @default(autoincrement())
  name   String
  date   String // "YYYY-MM-DD"
  annual Boolean @default(false)
  kind   String  @default("Festival") // Festival | Public holiday | Observance | Custom
  note   String  @default("")

  // Seeded rows are marked, so the starter set can be told apart from
  // anything the team added themselves.
  seeded Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([name, date])
  @@index([date])
}
