# Direct Postgres connection string. Any ONE of these names works — the app
# checks them in this order, so Vercel's prefixed variables need no duplicate:
#
#   DATABASE_URL              (set this to override the others)
#   DATABASE1_DATABASE_URL    (created by Vercel's database integration)
#   DATABASE1_POSTGRES_URL    (same, alternative name)
#
# Use the postgres:// value. DATABASE1_PRISMA_DATABASE_URL is the Accelerate
# URL — it speaks HTTP and is rejected with an explanation.
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Password your team types on the agency login screen.
APP_SECRET="change-me"
