# Direct Postgres connection string. Vercel's database integration may expose
# this under a prefixed name (e.g. DATABASE1_DATABASE_URL) — add a plain
# DATABASE_URL with the same value so the Prisma CLI finds it too.
# Use the postgres:// URL, not the prisma+postgres:// Accelerate one.
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Password your team types on the agency login screen.
APP_SECRET="change-me"
